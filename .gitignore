# Credentials and Environment Variables (CRITICAL)
.env

# Python caching 
__pycache__/
*.pyc
.pytest_cache/

# Ignore everything inside data/ by default
data/*

# EXCEPT the raw and processed subfolders
!data/raw/
!data/processed/

# Keep gitkeep files if present
!data/**/.gitkeep

# System files
.DS_Store
Thumbs.db

# Ignore log files
*.log

